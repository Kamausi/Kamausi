rules_version = '2';
// Skull Toss. The client writes only its own save; everything that is worth something (Souls, the leaderboard,
// store receipts, the ledger) is written by Cloud Functions alone, which bypass these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    // the cloud save: profile and looks, merged with the device's copy. Never Souls: they aren't part of it.
    match /data/users/{uid}/save {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size() < 900000
        && !('souls' in request.resource.data) && !('wallet' in request.resource.data);
    }
    // Souls: the balance and what it bought. Read your own; only the server writes.
    match /wallets/{uid} { allow read: if request.auth != null && request.auth.uid == uid; allow write: if false; }
    match /ledger/{id} { allow read, write: if false; }
    match /receipts/{id} { allow read, write: if false; }
    // the leaderboard: anyone signed in can read it; only the server's run check writes it (v34)
    match /leaderboard/{uid} { allow read: if request.auth != null; allow write: if false; }
    match /weekly/{id} { allow read: if request.auth != null; allow write: if false; }
    // v45: a board for each scored mode, written only by the server's run check, like the Adventure's
    match /boards/{id} { allow read: if request.auth != null; allow write: if false; }
    // v45: who's about: each player keeps one doc of their own, holding only the server's clock at their last visit
    match /presence/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["at"]) && request.resource.data.at == request.time;
    }
    match /runs/{id} { allow read, write: if false; }
    match /meta/{id} { allow read, write: if false; }
    // remote config and feature flags (v39): public to read, written from the console
    match /config/{doc} { allow read: if true; allow write: if false; }
    // analytics (v39) arrive through a function, only with the player's consent
    match /events/{id} { allow read, write: if false; }
    match /metrics/{id} { allow read, write: if false; }
    match /ameta/{id} { allow read, write: if false; }
  }
}
