{
  "name": "skull-toss-app",
  "private": true,
  "version": "1.0.0",
  "description": "Skull Toss for iOS and Android: the game's page in a Capacitor shell.",
  "scripts": {
    "web": "python3 ../../tools/package.py capacitor",
    "assets": "npx @capacitor/assets generate --iconBackgroundColor '#26364A' --splashBackgroundColor '#17130F'",
    "sync": "npm run web && npx cap sync",
    "ios": "npm run sync && npx cap open ios",
    "android": "npm run sync && npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/ios": "^6.1.0",
    "@capacitor/screen-orientation": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@capacitor-community/admob": "^6.0.0",
    "cordova-plugin-purchase": "^13.10.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.0"
  }
}
